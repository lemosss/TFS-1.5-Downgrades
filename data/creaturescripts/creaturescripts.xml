	     TFS 1.5 (they exist only in OTX). Kept registered as-is for the user; engine
	     emits a configure-error and skips them. To activate these, the C++ source
	     needs to expose those CreatureEventType values, which requires source patches. -->
	<event type="moveitem" name="MoveItem" script="houseprotect.lua"/>
	<event type="channeljoin" name="GuildEvents" script="guild.lua"/>
	<event type="mailreceive" name="Mail" script="mail.lua"/>
